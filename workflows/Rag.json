    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS rag_projects (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  created_at TIMESTAMPTZ DEFAULT NOW()\n);\n\nSELECT\n  p.id,\n  p.name,\n  to_char(p.created_at, 'YYYY-MM-DD') AS \"createdAt\",\n  COALESCE(\n    (\n      SELECT json_agg(DISTINCT sub.file_name)\n      FROM (\n        SELECT metadata->>'file_name' AS file_name\n        FROM n8n_vectors\n        WHERE metadata->>'project_id' = p.id\n          AND metadata->>'file_name' IS NOT NULL\n      ) sub\n    ),\n    '[]'::json\n  ) AS documents\nFROM rag_projects p\n\nUNION ALL\n\nSELECT\n  v.project_id AS id,\n  v.project_id AS name,\n  '' AS \"createdAt\",\n  json_agg(DISTINCT v.file_name) AS documents\nFROM (\n  SELECT DISTINCT\n    metadata->>'project_id' AS project_id,\n    metadata->>'file_name' AS file_name\n  FROM n8n_vectors\n  WHERE metadata->>'project_id' IS NOT NULL\n    AND metadata->>'file_name' IS NOT NULL\n) v\nWHERE NOT EXISTS (\n  SELECT 1 FROM rag_projects p WHERE p.id = v.project_id\n)\nGROUP BY v.project_id;"
      },
