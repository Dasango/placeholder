      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS rag_projects (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  created_at TIMESTAMPTZ DEFAULT NOW()\n);\nINSERT INTO rag_projects (id, name)\nVALUES ('{{ $json.body.projectId }}', '{{ $json.body.name }}')\nON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name\nRETURNING id, name, to_char(created_at, 'YYYY-MM-DD') AS \"createdAt\";"
